# Copy to .env.local and fill in.

# From Supabase project settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). Server only — never expose, never commit.
SUPABASE_SECRET_KEY=

# Whatever password you want to type once per device.
APP_PASSWORD=
# Random 32-byte hex. Generate with: openssl rand -hex 32
AUTH_SECRET=
